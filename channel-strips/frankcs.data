[{"_1":2,"_3":4},"routes/docs-layout",{"_5":176},"routes/channel-strip",{"_5":6},"data",{"_7":8,"_9":10,"_11":12},"strip",{"_19":20,"_21":22,"_23":24,"_25":26,"_27":28,"_29":30,"_31":32},"prev",{"_13":17,"_15":18},"next",{"_13":14,"_15":16},"to","/channel-strips/british-channel","title","British Channel","/channel-strips/channev","CHANNEV","slug","frankcs","name","FrankCS","vendor","AnalogObsession","notes","Analog Obsession FrankCS (Ultimate Channelstrip). The low band is Pultec-style: Gain is the low BOOST, its ATTEN is on the EQ's small knobs. The plugin's MID band is the low-mid band here (75 Hz to 12.5 kHz). High atten and its frequency are small knobs too (HATT, HFRQ); there is no low pass. Attack, release and ratio click through the plugin's steps. The compressor has no makeup gain. TUBE buttons switch the preamp (IN) and the compressor model; OS is oversampling. The EQ and COMP buttons are the plugin's \"EQ Bypass\" and \"Compressor Bypass\" parameters, which are 1 when the section is on. The fader is the plugin's Output (-24 to +24 dB).","shell",false,"shared",[61,62,63,64,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79,80,81,82,83,84,85,86,87,88,89,90,91,92,93,94,95,96],"own",[33,34,35,36,37,38],{"_39":40,"_41":59,"_43":60,"_45":46,"_47":-7},{"_39":56,"_41":57,"_43":58,"_45":46,"_47":-7},{"_39":54,"_41":55,"_43":50,"_45":51,"_47":-7},{"_39":52,"_41":53,"_43":50,"_45":51,"_47":-7},{"_39":48,"_41":49,"_43":50,"_45":51,"_47":-7},{"_39":40,"_41":42,"_43":44,"_45":46,"_47":-7},"label","TUBE","param","Compressor Model","section","COMP","behaviour","Switch","steps","HFRQ","High Atten Frequency","EQ","Continuous","HATT","High Atten","LATT","Low Atten","OS","Oversampling","Global","Preamp Model","IN",{"_97":174,"_99":169,"_39":175,"_41":-5,"_45":-5},{"_97":173,"_99":169,"_39":120,"_41":169,"_45":51},{"_97":171,"_99":169,"_39":172,"_41":-5,"_45":-5},{"_97":168,"_99":169,"_39":170,"_41":-5,"_45":-5},{"_97":166,"_99":161,"_39":167,"_41":-5,"_45":-5},{"_97":163,"_99":161,